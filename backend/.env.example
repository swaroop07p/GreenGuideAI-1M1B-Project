# ==============================================================================
# GreenGuide AI - Backend Environment Variables
# ==============================================================================

# Gemini AI API Configuration (Optional)
# If omitted or left empty, GreenGuide AI runs seamlessly using the deterministic IPCC/EPA engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# CORS Allowed Origins
# In production on Render, set this to your Vercel URL (e.g. https://your-app.vercel.app)
# or comma-separated list of origins. Set to '*' to allow all origins.
ALLOWED_ORIGINS=*

# Server Binding
# In production on Render, HOST and PORT are managed automatically by Render ($PORT).
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
