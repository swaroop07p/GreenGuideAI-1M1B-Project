# GreenGuide AI Frontend Environment Variables
# In production on Vercel:
# Set this to your deployed Render backend URL (no trailing slash).
# Example: https://greenguide-backend.onrender.com
#
# In local development:
# Leave blank or omit to use Vite's local development proxy (/api -> http://127.0.0.1:8000).
VITE_API_BASE_URL=
